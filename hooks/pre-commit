#!/bin/bash
# hooks/pre-commit — v1.2, Γ_Locality compliant
echo "🛡️ TS-Validator Pre-Commit: проверка инвариантов..."

# Проверяем только changed files в causal_window (contracts/ и validator/)
CHANGED_FILES=$(git diff --cached --name-only -- 'contracts/*' 'validator/*' | wc -l | tr -d ' ')

if [ "$CHANGED_FILES" -eq 0 ]; then
    echo "✅ Нет изменений в causal_window. Hook пропускает."
    exit 0
fi

if [ "$CHANGED_FILES" -gt 15 ]; then
    echo "⚠️  Превышен causal_window (>15 файлов). Локальная валидация отключена (Γ_Locality)."
    echo "📜 Запустите вручную: ./scripts/run_full_validation_pipeline.sh"
    exit 0
fi

# Запускаем валидацию только для затронутых слоёв
if ! ./scripts/run_full_validation_pipeline.sh > /tmp/ts_precommit.log 2>&1; then
    echo "❌ COMMIT REJECTED: Нарушение конституционных инвариантов."
    echo "📜 Детали:"
    cat /tmp/ts_precommit.log
    echo "⚠️  Исправьте YAML/контракты или запустите ./scripts/run_full_validation_pipeline.sh"
    exit 1
fi

echo "✅ Pre-commit PASSED: Конституционный контур валиден."
exit 0
